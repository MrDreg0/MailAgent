@inherits LayoutComponentBase

<div class="bb-page">
  <NavMenu @ref="_navMenu" />
  <main>
    <div class="bb-top-row px-4 d-flex justify-content-between align-items-center">
      <Icon Name="IconName.List" role="button" @onclick="ToggleSidebar" />

      <span class="text-body-secondary small">Mail Archive Viewer</span>
    </div>

    <article class="content px-4">
      @Body
    </article>
  </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
  An unhandled error has occurred.
  <a href="." class="reload">Reload</a>
  <span class="dismiss">x</span>
</div>

@code {
  private NavMenu? _navMenu;

  private Task ToggleSidebar()
    => _navMenu?.Toggle() ?? Task.CompletedTask;
}
