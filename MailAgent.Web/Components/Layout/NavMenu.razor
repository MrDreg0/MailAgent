<Sidebar @ref="_sidebar"
         Href="/"
         IconName="IconName.EnvelopeFill"
         Title="MailAgent"
         DataProvider="SidebarDataProvider" />

@code {
  private Sidebar _sidebar = default!;
  private IEnumerable<NavItem>? _navItems;

  public Task Toggle()
  {
    _sidebar.ToggleSidebar();
    return Task.CompletedTask;
  }

  private Task<SidebarDataProviderResult> SidebarDataProvider(SidebarDataProviderRequest request)
  {
    _navItems ??=
    [
      new NavItem
      {
        Href = "/",
        IconName = IconName.HouseDoorFill,
        Text = "Overview"
      },
      new NavItem
      {
        Href = "/messages",
        IconName = IconName.Table,
        Text = "Mail Archive"
      },
      new NavItem
      {
        Href = "/daily-digests",
        IconName = IconName.FileText,
        Text = "Daily Digests"
      }
    ];

    return Task.FromResult(request.ApplyTo(_navItems));
  }
}
