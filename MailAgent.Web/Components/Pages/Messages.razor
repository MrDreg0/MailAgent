@page "/messages"
@using MailAgent.Application.Exceptions
@using MailAgent.Web.Browse
@inject MailBrowserService MailBrowserService

<PageTitle>Mail Archive</PageTitle>

<div class="py-4">
  <div class="mb-4">
    <h1 class="mb-1">Mail Archive</h1>
    <p class="text-body-secondary mb-0">Browse stored messages and inspect their original content.</p>
  </div>

  @if (!string.IsNullOrEmpty(_errorMessage))
  {
    <Alert Color="AlertColor.Danger">
      <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>
      @_errorMessage
    </Alert>
  }

  @if (_isLoading)
  {
    <div class="d-flex align-items-center gap-3 py-3">
      <Spinner Color="SpinnerColor.Primary" />
      <span>Loading messages...</span>
    </div>
  }

  <Card>
    <CardBody>
      <Grid TItem="StoredMail"
            Class="table table-hover align-middle"
            DataProvider="MailsDataProvider"
            AllowPaging="true"
            AutoHidePaging="true"
            EmptyText="No stored messages found."
            PageSize="10"
            PageSizeSelectorVisible="true"
            PageSizeSelectorItems="@PageSizeOptions"
            PaginationItemsTextFormat="{0}-{1} of {2}"
            ItemsPerPageText="Per page"
            Responsive="true"
            AllowDetailView="true">
        <GridColumns>
          <GridColumn TItem="StoredMail" HeaderText="Id">
            @context.Id
          </GridColumn>
          <GridColumn TItem="StoredMail" HeaderText="Folder">
            @context.Folder
          </GridColumn>
          <GridColumn TItem="StoredMail" HeaderText="DateUtc">
            @context.DateUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
          </GridColumn>
          <GridColumn TItem="StoredMail" HeaderText="From">
            <div class="text-break">@context.From</div>
          </GridColumn>
          <GridColumn TItem="StoredMail" HeaderText="Subject">
            <div class="text-break">@context.Subject</div>
          </GridColumn>
          <GridColumn TItem="StoredMail" HeaderText="MessageId">
            <div class="text-break small">@context.MessageId</div>
          </GridColumn>
        </GridColumns>
        
        <GridDetailView TItem="StoredMail">
          <Card class="mt-4">
            <CardHeader>
              <div class="d-flex flex-column gap-1">
                <div class="fw-semibold text-break">@context.Subject</div>
                <div class="small text-body-secondary text-break">
                  <span>From: @context.From</span>
                  <span class="mx-2">•</span>
                  <span>Folder: @context.Folder</span>
                  <span class="mx-2">•</span>
                  <span>@context.DateUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</span>
                </div>
              </div>
            </CardHeader>
            <CardBody>
              <MailPreviewDocument Body="@context.RawBody" />
            </CardBody>
          </Card>
        </GridDetailView>
      </Grid>
    </CardBody>
  </Card>
</div>

@code {
  private static readonly int[] PageSizeOptions = [10, 25, 100];

  private bool _isLoading = true;
  private string? _errorMessage;
  private StoredMail? _selectedMail;

  private async Task<GridDataProviderResult<StoredMail>> MailsDataProvider(GridDataProviderRequest<StoredMail> request)
  {
    try
    {
      _errorMessage = null;
      var mailPage = await MailBrowserService.GetPage(request.PageNumber, request.PageSize);
      _selectedMail = KeepSelectedMailIfPresent(mailPage.Items, _selectedMail);

      return new GridDataProviderResult<StoredMail>
      {
        Data = mailPage.Items,
        TotalCount = mailPage.TotalCount
      };
    }
    catch (MailAgentException exception)
    {
      _errorMessage = $"Failed to load messages: {exception.Message}";

      return new GridDataProviderResult<StoredMail>
      {
        Data = [],
        TotalCount = 0
      };
    }
    catch (Exception exception)
    {
      _errorMessage = $"Failed to load messages: {exception.Message}";

      return new GridDataProviderResult<StoredMail>
      {
        Data = [],
        TotalCount = 0
      };
    }
    finally
    {
      _isLoading = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private static StoredMail? KeepSelectedMailIfPresent(IReadOnlyList<StoredMail> items, StoredMail? selectedMail)
  {
    if (selectedMail is null)
    {
      return null;
    }

    return items.FirstOrDefault(mail => mail.Id == selectedMail.Id);
  }
}
