@page "/messages"
@using MailAgent.Web.Browse
@rendermode InteractiveServer
@inject MailBrowserService MailBrowserService

<PageTitle>Messages</PageTitle>

<div class="py-4">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
      <h1 class="mb-1">Сообщения</h1>
    </div>

    <div class="d-flex align-items-center gap-2">
      <label class="form-label mb-0" for="page-size">На странице</label>
      <select id="page-size" class="form-select" style="width: auto;" @bind="_pageSize" @bind:after="HandlePageSizeChanged">
        @foreach (var option in PageSizeOptions)
        {
          <option value="@option">@option</option>
        }
      </select>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(_errorMessage))
  {
    <div class="alert alert-danger" role="alert">
      @_errorMessage
    </div>
  }
  else if (_isLoading)
  {
    <div class="d-flex align-items-center gap-3 py-5">
      <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
      <span>Загрузка сообщений...</span>
    </div>
  }
  else if (_mailPage is null || _mailPage.TotalCount == 0)
  {
    <div class="alert alert-light border" role="status">
      В базе пока нет сохраненных сообщений.
    </div>
  }
  else
  {
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col">Id</th>
                <th scope="col">Folder</th>
                <th scope="col">DateUtc</th>
                <th scope="col">From</th>
                <th scope="col">Subject</th>
                <th scope="col">MessageId</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var mail in _mailPage.Items)
              {
                <tr>
                  <td>@mail.Id</td>
                  <td>@mail.Folder</td>
                  <td>@mail.DateUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</td>
                  <td class="text-break">@mail.From</td>
                  <td class="text-break">@mail.Subject</td>
                  <td class="text-break small">@mail.MessageId</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
      </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3">
      <div class="text-body-secondary">
        Показано @(StartItem)-@(EndItem) из @_mailPage.TotalCount
      </div>

      <nav aria-label="Messages pages">
        <ul class="pagination mb-0">
          <li class="page-item @(_currentPage == 1 ? "disabled" : null)">
            <button type="button" class="page-link" @onclick="() => ChangePage(_currentPage - 1)" disabled="@(_currentPage == 1)">Назад</button>
          </li>
          @foreach (var pageNumber in VisiblePages)
          {
            <li class="page-item @(pageNumber == _currentPage ? "active" : null)">
              <button type="button" class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
            </li>
          }
          <li class="page-item @(_currentPage == TotalPages ? "disabled" : null)">
            <button type="button" class="page-link" @onclick="() => ChangePage(_currentPage + 1)" disabled="@(_currentPage == TotalPages)">Вперед</button>
          </li>
        </ul>
      </nav>
    </div>
  }
</div>

@code {
  private static readonly int[] PageSizeOptions = [10, 25, 100];

  private MailPageResult? _mailPage;
  private bool _isLoading = true;
  private string? _errorMessage;
  private int _currentPage = 1;
  private int _pageSize = 10;

  private int TotalPages => _mailPage is null || _mailPage.TotalCount == 0
    ? 1
    : (int)Math.Ceiling(_mailPage.TotalCount / (double)_mailPage.PageSize);

  private int StartItem => _mailPage is null || _mailPage.TotalCount == 0
    ? 0
    : ((_mailPage.PageNumber - 1) * _mailPage.PageSize) + 1;

  private int EndItem => _mailPage is null
    ? 0
    : Math.Min(_mailPage.PageNumber * _mailPage.PageSize, _mailPage.TotalCount);

  private IEnumerable<int> VisiblePages
  {
    get
    {
      if (_mailPage is null)
      {
        yield break;
      }

      var startPage = Math.Max(1, _currentPage - 2);
      var endPage = Math.Min(TotalPages, startPage + 4);
      startPage = Math.Max(1, endPage - 4);

      for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
      {
        yield return pageNumber;
      }
    }
  }

  protected override Task OnInitializedAsync()
    => LoadPage();

  private Task HandlePageSizeChanged()
  {
    _currentPage = 1;
    return LoadPage();
  }

  private Task ChangePage(int nextPage)
  {
    if (nextPage < 1 || nextPage > TotalPages || nextPage == _currentPage)
    {
      return Task.CompletedTask;
    }

    _currentPage = nextPage;
    return LoadPage();
  }

  private async Task LoadPage()
  {
    _isLoading = true;
    _errorMessage = null;

    try
    {
      _mailPage = await MailBrowserService.GetPage(_currentPage, _pageSize);

      if (_mailPage.TotalCount > 0 && _currentPage > TotalPages)
      {
        _currentPage = TotalPages;
        _mailPage = await MailBrowserService.GetPage(_currentPage, _pageSize);
      }
    }
    catch (Exception exception)
    {
      _errorMessage = $"Не удалось загрузить сообщения: {exception.Message}";
    }
    finally
    {
      _isLoading = false;
    }
  }
}
