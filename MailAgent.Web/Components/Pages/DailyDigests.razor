@page "/daily-digests"
@using MailAgent.Api.Contracts
@using MailAgent.Api.Contracts.DailyDigests
@using MailAgent.Web.Browse
@inject DailyDigestBrowserService DailyDigestBrowserService
@inject IMailAgentApi MailAgentApi

<PageTitle>Daily Digests</PageTitle>

<div class="py-4">
  <div class="mb-4">
    <h1 class="mb-1">Daily Digests</h1>
    <p class="text-body-secondary mb-0">Browse persisted daily release summaries built from stored mails.</p>
  </div>

  @if (!string.IsNullOrEmpty(_errorMessage))
  {
    <Alert Color="AlertColor.Danger">
      <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>
      @_errorMessage
    </Alert>
  }

  @if (!string.IsNullOrEmpty(_successMessage))
  {
    <Alert Color="AlertColor.Success"
           Dismissable="true"
           Visible="@_isSuccessMessageVisible"
           OnClosed="HideSuccessMessage">
      <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon>
      @_successMessage
    </Alert>
  }

  @if (_isLoading)
  {
    <div class="d-flex align-items-center gap-3 py-3">
      <Spinner Color="SpinnerColor.Primary" />
      <span>Loading daily digests...</span>
    </div>
  }

  <Card>
    <CardBody>
      <Grid TItem="DailyDigest"
            Class="table table-hover align-middle"
            DataProvider="DailyDigestsDataProvider"
            AllowPaging="true"
            AutoHidePaging="true"
            EmptyText="No persisted daily digests found."
            PageSize="10"
            PageSizeSelectorVisible="true"
            PageSizeSelectorItems="@PageSizeOptions"
            PaginationItemsTextFormat="{0}-{1} of {2}"
            ItemsPerPageText="Per page"
            Responsive="true"
            AllowDetailView="true">
        <GridColumns>
          <GridColumn TItem="DailyDigest" HeaderText="Date">
            @{
              var digest = GetVisibleDigest(context);
            }
            @digest.DigestDate.ToString("yyyy-MM-dd")
          </GridColumn>
          <GridColumn TItem="DailyDigest" HeaderText="Folder">
            @GetVisibleDigest(context).Folder
          </GridColumn>
          <GridColumn TItem="DailyDigest" HeaderText="Fetched">
            @GetVisibleDigest(context).TotalFetched
          </GridColumn>
          <GridColumn TItem="DailyDigest" HeaderText="Selected">
            @GetVisibleDigest(context).Selected
          </GridColumn>
          <GridColumn TItem="DailyDigest" HeaderText="Generated">
            @GetVisibleDigest(context).GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
          </GridColumn>
        </GridColumns>

        <GridDetailView TItem="DailyDigest">
          @{
            var digest = GetVisibleDigest(context);
          }
          <Card class="mt-4 digest-detail-card">
            <CardHeader>
              <div class="d-flex flex-column gap-2">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                  <div class="fw-semibold">Release Digest for @digest.DigestDate.ToString("yyyy-MM-dd")</div>
                  <Button Color="@(IsRegenerating(digest) ? ButtonColor.Secondary : ButtonColor.Primary)"
                          Size="ButtonSize.Small"
                          Loading="@IsRegenerating(digest)"
                          LoadingText="Regenerating..."
                          Disabled="@IsRegenerating(digest)"
                          @onclick="async () => await RegenerateDigest(digest)">
                    <span>Regenerate</span>
                  </Button>
                </div>
                <div class="d-flex flex-wrap gap-2 digest-metadata">
                  <Badge Color="BadgeColor.Secondary">Folder: @digest.Folder</Badge>
                  <Badge Color="BadgeColor.Light">Fetched: @digest.TotalFetched</Badge>
                  <Badge Color="BadgeColor.Light">Selected: @digest.Selected</Badge>
                  <Badge Color="BadgeColor.Light">Generated: @digest.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</Badge>
                </div>
              </div>
            </CardHeader>
            <CardBody>
              @if (IsRegenerating(digest))
              {
                <div class="digest-loading-state">
                  <div class="digest-loading-dots">...</div>
                  <div class="text-body-secondary">Regenerating digest...</div>
                </div>
              }
              else
              {
                <DailyDigestDocument Content="@digest.DigestMarkdown" />
              }
            </CardBody>
          </Card>
        </GridDetailView>
      </Grid>
    </CardBody>
  </Card>
</div>

@code {
  private const string FolderName = "Releases";
  private static readonly int[] PageSizeOptions = [10, 25, 100];

  private readonly HashSet<string> _regeneratingDigestKeys = [];
  private readonly Dictionary<string, DailyDigest> _updatedDigests = [];
  private bool _isLoading = true;
  private bool _isSuccessMessageVisible;
  private string? _errorMessage;
  private string? _successMessage;

  private async Task<GridDataProviderResult<DailyDigest>> DailyDigestsDataProvider(GridDataProviderRequest<DailyDigest> request)
  {
    try
    {
      _errorMessage = null;

      var digestPage = await DailyDigestBrowserService.GetPage(FolderName, request.PageNumber, request.PageSize);

      return new GridDataProviderResult<DailyDigest>
      {
        Data = digestPage.Items,
        TotalCount = digestPage.TotalCount
      };
    }
    catch (Exception exception)
    {
      _errorMessage = $"Failed to load daily digests: {exception.Message}";

      return new GridDataProviderResult<DailyDigest>
      {
        Data = [],
        TotalCount = 0,
      };
    }
    finally
    {
      _isLoading = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task RegenerateDigest(DailyDigest digest)
  {
    var digestKey = GetDigestKey(digest);

    if (!_regeneratingDigestKeys.Add(digestKey))
    {
      return;
    }

    _errorMessage = null;
    _successMessage = null;

    try
    {
      var regeneratedDigest = await MailAgentApi.RegenerateDailyDigest(digest.DigestDate.ToString("yyyy-MM-dd"), digest.Folder);
      _updatedDigests[digestKey] = ToDailyDigest(regeneratedDigest);
      _successMessage = $"Daily digest for {digest.DigestDate:yyyy-MM-dd} was regenerated.";
      _isSuccessMessageVisible = true;
    }
    catch (Exception exception)
    {
      _errorMessage = $"Failed to regenerate daily digest: {exception.Message}";
    }
    finally
    {
      _regeneratingDigestKeys.Remove(digestKey);
      await InvokeAsync(StateHasChanged);
    }
  }

  private bool IsRegenerating(DailyDigest digest)
  {
    return _regeneratingDigestKeys.Contains(GetDigestKey(digest));
  }

  private DailyDigest GetVisibleDigest(DailyDigest digest)
  {
    var digestKey = GetDigestKey(digest);
    return _updatedDigests.GetValueOrDefault(digestKey) ?? digest;
  }

  private Task HideSuccessMessage()
  {
    _isSuccessMessageVisible = false;
    return Task.CompletedTask;
  }

  private static DailyDigest ToDailyDigest(DailyDigestDocumentResponse digest)
  {
    return new DailyDigest(
      digest.Id,
      digest.Folder,
      digest.DigestDate,
      digest.TotalFetched,
      digest.Selected,
      digest.DigestMarkdown,
      digest.GeneratedAtUtc);
  }

  private static string GetDigestKey(DailyDigest digest)
  {
    return $"{digest.Folder}:{digest.DigestDate:yyyy-MM-dd}";
  }
}
