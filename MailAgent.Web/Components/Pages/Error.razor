@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="py-4">
  <Alert Color="AlertColor.Danger">
    <Icon Name="IconName.ExclamationOctagonFill" class="me-2"></Icon>
    При обработке запроса произошла ошибка.
  </Alert>

  <Card>
    <CardBody>
      @if (ShowRequestId)
      {
        <CardText>
          <strong>Request ID:</strong> <code>@RequestId</code>
        </CardText>
      }

      <CardTitle>Режим разработки</CardTitle>
      <CardText>
        В окружении <strong>Development</strong> будет показана дополнительная информация об ошибке.
      </CardText>
      <CardText>
        Не включай <strong>Development</strong> на развернутом приложении, потому что это может раскрыть чувствительные детали.
      </CardText>
    </CardBody>
  </Card>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
