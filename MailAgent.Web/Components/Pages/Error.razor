@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="py-4">
  <Alert Color="AlertColor.Danger">
    <Icon Name="IconName.ExclamationOctagonFill" class="me-2"></Icon>
    An error occurred while processing the request.
  </Alert>

  <Card>
    <CardBody>
      @if (ShowRequestId)
      {
        <CardText>
          <strong>Request ID:</strong> <code>@RequestId</code>
        </CardText>
      }

      <CardTitle>Development mode</CardTitle>
      <CardText>
        Switching to the <strong>Development</strong> environment shows more detailed error information.
      </CardText>
      <CardText>
        Do not enable <strong>Development</strong> in deployed environments because it may expose sensitive details.
      </CardText>
    </CardBody>
  </Card>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
